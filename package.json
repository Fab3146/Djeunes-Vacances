{
  "name": "argentine-a9",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:catalog && next dev --webpack",
    "build": "npm run build:catalog && npm test && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:catalog": "node scripts/build-argentine.cjs",
    "test": "node --test tests/*.test.cjs",
    "db:migrate": "node scripts/argentine-db.cjs migrate",
    "db:seed": "node scripts/argentine-db.cjs seed"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  }
}
